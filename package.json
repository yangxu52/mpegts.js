{
  "name": "mpegts.js",
  "version": "1.8.0",
  "description": "HTML5 MPEG2-TS Stream Player",
  "type": "module",
  "main": "./dist/mpegts.cjs",
  "module": "./dist/mpegts.js",
  "types": "./dist/mpegts.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mpegts.d.ts",
      "import": "./dist/mpegts.js",
      "require": "./dist/mpegts.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xqq/mpegts.js"
  },
  "keywords": [
    "html5",
    "mpegts",
    "m2ts",
    "mse",
    "arib",
    "dvb"
  ],
  "scripts": {
    "build": "tsdown",
    "build:debug": "tsdown --no-minify",
    "lint": "eslint src tsdown.config.ts",
    "tsc": "tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm tsc",
    "watch": "tsdown --watch",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express-serve-static-core": "4.17.37",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.4",
    "events": "^3.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "minimist": ">=1.2.6",
    "prettier": "^3.8.3",
    "socket.io-parser": ">=3.3.3",
    "ssri": ">=8.0.1",
    "tsdown": "^0.22.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.59.2",
    "ws": ">=7.4.6",
    "xmlhttprequest-ssl": ">=1.6.2"
  },
  "author": "zheng qian <xqq@xqq.im>",
  "license": "Apache-2.0",
  "engines": {
    "pnpm": ">=10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js|*.mjs|*.cjs|*.ts|*.mts|*.cts)": [
      "prettier --write --ignore-unknown"
    ]
  }
}
