{
  "compilerOptions": {
    "allowJs": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2015",
    "experimentalDecorators": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2015", "DOM", "WebWorker"]
  },
  "include": ["./src/**/*", "tsdown.config.ts"]
}
